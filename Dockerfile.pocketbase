# PocketBase for Nexus Store. Use a persistent disk at /pb/pb_data.
FROM alpine:3.21
RUN apk add --no-cache ca-certificates curl unzip
ARG PB_VERSION=0.42.2
RUN curl -fsSL "https://github.com/pocketbase/pocketbase/releases/download/v${PB_VERSION}/pocketbase_${PB_VERSION}_linux_amd64.zip" -o /tmp/pocketbase.zip \
    && unzip -q /tmp/pocketbase.zip pocketbase -d /usr/local/bin \
    && chmod +x /usr/local/bin/pocketbase \
    && rm /tmp/pocketbase.zip
WORKDIR /pb
COPY PocketBase/pb_hooks /pb/pb_hooks
COPY PocketBase/pb_migrations /pb/pb_migrations
EXPOSE 10000
CMD ["sh", "-c", "exec pocketbase serve --http=0.0.0.0:${PORT:-10000} --dir=/pb/pb_data --hooksDir=/pb/pb_hooks --migrationsDir=/pb/pb_migrations"]
