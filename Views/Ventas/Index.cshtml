@model List<Venta>
@{ ViewData["Title"] = "Historial de ventas"; }
<div class="heading"><div><div class="eyebrow">OPERACIONES / HISTORIAL</div><h1>Historial de ventas</h1><p>Tu actividad comercial en un solo registro.</p></div><a class="btn btn-primary" asp-action="Crear">+ NUEVA VENTA</a></div>
<div class="catalog-toolbar"><span>TODAS LAS TRANSACCIONES</span><span class="transaction-count">@Model.Count REGISTROS</span></div>
<section class="panel table-wrap"><table><thead><tr><th>N.º DE VENTA</th><th>CLIENTE</th><th>FECHA</th><th>ARTÍCULOS</th><th>TOTAL</th><th></th></tr></thead><tbody>
@foreach(var v in Model) { <tr><td class="bold">#@v.Id.ToString("D4")</td><td>@v.Cliente</td><td>@v.FechaUtc.ToLocalTime().ToString("dd/MM/yyyy · HH:mm")</td><td>@v.Detalles.Sum(d => d.Cantidad)</td><td class="price-text"><div class="dual-price">@Monedas.Cordobas(v.Total)<small>@Monedas.Dolares(v.Total, v.CordobasPorDolar)</small></div></td><td><a asp-action="Detalle" asp-route-id="@v.Id">DETALLES →</a></td></tr> }
</tbody></table>@if(Model.Count == 0) { <div class="empty-state"><span>▤</span><strong>No hay ventas registradas</strong><p>Las operaciones aparecerán aquí después de confirmar una venta.</p><a class="btn btn-primary" asp-action="Crear">COMENZAR A VENDER</a></div> }</section>