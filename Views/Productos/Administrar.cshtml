@model List<Producto>
@{ ViewData["Title"] = "Administrar inventario"; }
<div class="heading catalog-heading">
    <div><h1>Administrar inventario</h1><p>Registra productos y actualiza precios, fotos y existencias.</p></div>
    <a class="btn btn-primary" asp-action="Crear">+ Registrar producto</a>
</div>
<section class="panel admin-panel">
    @if (Model.Count == 0)
    {
        <div class="empty-state"><strong>El inventario está vacío</strong></div>
    }
    else
    {
        <div class="table-wrap">
            <table class="inventory-table">
                <thead><tr><th>Producto</th><th>Estado</th><th>Precio</th><th>Stock</th><th>Disponibilidad</th><th>Acciones</th></tr></thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td><div class="inventory-item">
                                @if (p.Foto is { } foto) { <img src="@Url.Action("Foto", new { nombre = foto })" alt="" loading="lazy" /> }
                                <div><strong>@p.Nombre</strong><small>@p.Categoria · @(string.IsNullOrWhiteSpace(p.Marca) ? "Marca sin especificar" : p.Marca)</small></div>
                            </div></td>
                            <td>@p.Estado</td>
                            <td><div class="dual-price"><strong>@Monedas.Cordobas(p.Precio)</strong><small>@Monedas.Dolares(p.Precio)</small></div></td>
                            <td>@p.Stock</td>
                            <td><span class="chip @(!p.EnVenta ? "low" : "")">@(p.EnVenta ? "Disponible" : p.Stock == 0 ? "Agotado" : "No disponible")</span></td>
                            <td><div class="product-actions">
                                <a class="btn btn-outline small" asp-action="Editar" asp-route-id="@p.Id">Editar</a>
                                <form asp-action="Eliminar" asp-route-id="@p.Id" method="post" onsubmit="return confirm('¿Eliminar este producto del catálogo?');">
                                    <button class="btn btn-danger small" type="submit">Eliminar</button>
                                </form>
                            </div></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
