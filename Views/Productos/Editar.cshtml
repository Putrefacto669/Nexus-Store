@model Producto
@{ ViewData["Title"] = "Editar producto"; }
<div class="heading catalog-heading"><h1>Editar producto</h1></div>
<section class="panel product-form">
    <form asp-action="Editar" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
        <input asp-for="Id" type="hidden" />
        <partial name="_Formulario" model="Model" />
    </form>
</section>
@section Scripts { <script src="~/js/precio.js" asp-append-version="true" defer></script> }
